# Local Compose development values
POSTGRES_USER=fulfillment
POSTGRES_PASSWORD=fulfillment_dev
POSTGRES_DB=fulfillment
POSTGRES_PORT=55432
DATABASE_URL=postgresql://fulfillment:fulfillment_dev@127.0.0.1:55432/fulfillment

# pytest creates a new database per run via this maintenance connection.
TEST_DATABASE_ADMIN_URL=postgresql://fulfillment:fulfillment_dev@127.0.0.1:55432/postgres

# Local analysis workspace
DEFAULT_DATASET_SOURCE=synthetic
ANALYSIS_MODE=rule
# Optional when ANALYSIS_MODE=model
# MODEL_BASE_URL=https://provider.example/v1
# MODEL_NAME=
# MODEL_API_KEY=
# MODEL_TIMEOUT_SECONDS=20
# MODEL_REASONING_EFFORT=low
